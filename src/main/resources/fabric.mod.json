{
  "schemaVersion": 1,
  "id": "pzmclient",
  "version": "${version}",
  "name": "PZM Client",
  "description": "PZM Studio's PvP utility mod. Kill effects, HUD overlays, sound customization, and more.",
  "authors": ["PZM Studio", "Paetyn"],
  "contact": {
    "homepage": "https://pzmstudio.com"
  },
  "license": "MIT",
  "icon": "assets/pzmclient/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.pzm.pzmclient.PzmClient"]
  },
  "mixins": ["pzmclient.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.5",
    "fabric-api": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  }
}
